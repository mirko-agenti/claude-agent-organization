{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-agent-organization.local/schemas/task.schema.json",
  "title": "Agent Task Schema",
  "description": "Standard schema for task exchange between AI agents.",
  "type": "object",

  "required": [
    "task_id",
    "request_id",
    "title",
    "description",
    "owner",
    "assigned_agent",
    "assignment_rationale",
    "priority",
    "risk_level",
    "status",
    "inputs",
    "expected_output",
    "acceptance_criteria",
    "dependencies",
    "created_at",
    "updated_at"
  ],

  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}-[0-9]{4}$",
      "description": "Unique identifier of the task."
    },

    "request_id": {
      "type": "string",
      "pattern": "^REQ-[0-9]{4}-[0-9]{4}$",
      "description": "Parent request identifier."
    },

    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200
    },

    "description": {
      "type": "string",
      "minLength": 20
    },

    "owner": {
      "type": "string",
      "description": "Human owner of the request."
    },

    "assigned_agent": {
      "type": "string",
      "enum": [
        "orchestrator",
        "general-specialist",
        "business-analyst",
        "financial-analyst",
        "research-specialist",
        "reviewer"
      ]
    },

    "assignment_rationale": {
      "type": "string",
      "minLength": 10,
      "description": "Motivation for assigning this task to the selected agent, coherent with the routing criteria defined in orchestrator.md (Agent Routing)."
    },

    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },

    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },

    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "in_progress",
        "blocked",
        "submitted_for_review",
        "revision_required",
        "approved",
        "completed",
        "cancelled"
      ]
    },

    "inputs": {
      "type": "array",
      "description": "Files, documents or references required.",
      "items": {
        "type": "string"
      }
    },

    "expected_output": {
      "type": "object",
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string"
        }
      }
    },

    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },

    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-[0-9]{4}-[0-9]{4}$"
      }
    },

    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "review": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reviewer": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "approved_with_comments",
            "rejected"
          ]
        }
      }
    },

    "human_approval": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "approved_with_conditions",
            "rejected"
          ]
        }
      }
    },

    "metadata": {
      "type": "object",
      "properties": {
        "estimated_effort": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string"
        }
      }
    },

    "created_at": {
      "type": "string",
      "format": "date-time"
    },

    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },

  "additionalProperties": false
}